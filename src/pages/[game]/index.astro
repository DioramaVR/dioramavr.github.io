---
// One page per game in the registry: /tpm-vr/, /deathsdoor-vr/, ...
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Smoke from '../../components/Smoke.astro';
import Credits from '../../components/Credits.astro';
import { load, installer, pickMedia, mediaUrl, fmtDate, fmtSize, setLabel, maturityLabel, severityLabel, type Game } from '../../data/load';
import { PATREON, CONTROLS, INSTALLER_URL } from '../../site';

export function getStaticPaths() {
  return load().games.map((game) => ({ params: { game: game.id }, props: { game } }));
}
interface Props { game: Game }
const { game } = Astro.props;
const info = game.info;
const { hero, turntable, turntableSources, gallery } = pickMedia(info);
const { latestVersion } = installer();
const media = (rel: string) => mediaUrl(game.id, rel);
const goodToKnow = [...(info?.needToKnow ?? []), ...(info?.requirements ?? [])];
const releases = game.index?.releases ?? [];
const coming = game.status === 'coming';
const crumbSet = game.setInfo ? setLabel(game.setInfo) : undefined;
const description = game.tagline ?? `${game.name}: a DioramaVR mod for ${game.game}.`;
---
{coming ? (
  <Base title={game.name} description={`${game.name} is coming to DioramaVR. Testing builds are on the Patreon.`} current="games" disclaimer={game.disclaimer} image={hero && media(hero.file)}>
    <div slot="top" class="smoke-host coming-hero" style="flex-direction: column">
      <Smoke calm="centre" />
      <Header current="games" />
      <main id="content" class="inner">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/#games">Games</a> <span aria-hidden="true">/</span> {crumbSet ?? game.name}</nav>
        <span class="badge coming">{game.closedBeta ? 'In closed beta on Patreon' : 'Coming'}</span>
        <h1 class="herotitle">{game.name}</h1>
        {game.tagline && <p class="tagline">{game.tagline}</p>}
        <p class="tagline">Free for everyone when it’s out.</p>
        <div class="actions">
          <a class="btn btn-primary btn-l" href={PATREON}>Get testing builds on Patreon</a>
          {load().games.some((g) => g.status !== 'coming') && <a class="btn btn-ghost btn-l" href="/#games">See what’s out now</a>}
        </div>
        <p class="small">For <a href={game.steamUrl}>{game.game} on Steam</a>, on a PC VR headset.</p>
        {game.closedBeta && (
          <section class="closed-install" aria-labelledby="ci-title">
            <h2 id="ci-title">Installing the closed beta</h2>
            <p>Patrons get the closed beta as a download on Patreon.</p>
            <p class="small">How to install it: more to come.</p>
          </section>
        )}
        {(hero || gallery.length > 0) && (
          <div class="stills">
            {[hero, ...gallery].filter(Boolean).slice(0, 3).map((m) => <img src={media(m!.file)} alt={m!.alt} loading="lazy" width="640" height="360">)}
          </div>
        )}
      </main>
    </div>
  </Base>
) : (
  <Base title={game.name} description={description} current="games" disclaimer={game.disclaimer} image={hero && media(hero.file)}>
    <div slot="top" class="smoke-host">
      <Smoke calm="left" />
      <Header current="games" />
      <section class="wrap game-hero" aria-labelledby="game-title">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/#games">Games</a> <span aria-hidden="true">/</span> {crumbSet && <>{crumbSet} <span aria-hidden="true">/</span> </>}{game.name}</nav>
        <div class="split">
          <div class="text">
            <div class="badges">
              {game.latestStable && <span class="badge stable">Stable {game.latestStable.version}</span>}
              {game.latestBeta && <span class="badge open-beta">Open beta {game.latestBeta.version}</span>}
              {game.closedBeta && <a class="badge plain closed" href={PATREON}>Next version in closed beta on Patreon</a>}
            </div>
            <h1 id="game-title" class="herotitle">{game.name}</h1>
            {game.tagline && <p class="tagline">{game.tagline}</p>}
            <div class="actions">
              {latestVersion
                ? <a class="btn btn-primary btn-l" href={INSTALLER_URL}>Download the installer</a>
                : <a class="btn btn-primary btn-l" href={PATREON}>Get it on Patreon</a>}
            </div>
            <p class="note">Needs <a href={game.steamUrl}>{game.game} on Steam</a> and a PC VR headset.</p>
          </div>
          {(turntable || hero) && (
            <figure>
              <div class="turntable">
                {turntable ? (
                  <video poster={turntable.poster && media(turntable.poster)} autoplay muted loop playsinline preload="metadata" aria-label={turntable.alt}>
                    {turntableSources.map((s) => <source src={media(s.file)} type={s.type}>)}
                  </video>
                ) : (
                  <img src={media(hero!.file)} alt={hero!.alt}>
                )}
              </div>
            </figure>
          )}
        </div>
      </section>
    </div>

    <main id="content">
      {(hero || gallery.length > 0) && (
        <section class="wrap section game-pictures" aria-label="Pictures" style="padding-top: 24px">
          {hero && <img class="hero-still" src={media(hero.file)} alt={hero.alt} loading="lazy" width="1920" height="1080">}
          {gallery.length > 0 && (
            <div class="gallery">
              {gallery.slice(0, 6).map((m) => <img src={media(m.file)} alt={m.alt} loading="lazy" width="960" height="540">)}
            </div>
          )}
        </section>
      )}

      <section class="section-deep" aria-labelledby="controls-title">
        <div class="wrap section">
          <div class="one-control">
            <div class="text">
              <h2 id="controls-title">Controls</h2>
              <p>{CONTROLS}</p>
            </div>
          </div>
        </div>
      </section>

      {(goodToKnow.length > 0 || info?.firstLaunch) && (
        <section class="wrap section" aria-labelledby="know-title" style="padding-bottom: 0">
          <h2 id="know-title" class="section-title" style="margin-bottom: 24px">Good to know</h2>
          <ul class="issues">
            {info?.firstLaunch && <li class="warn"><b>First start.</b> {info.firstLaunch}</li>}
            {goodToKnow.map((t) => <li>{t}</li>)}
          </ul>
        </section>
      )}

      <section class="wrap section" aria-labelledby="issues-title" style="padding-bottom: 0">
        <h2 id="issues-title" class="section-title" style="margin-bottom: 24px">Known issues</h2>
        {game.openIssues.length ? (
          <ul class="issues">
            {game.openIssues.map((i) => (
              <li id={`issue-${i.id}`} class:list={[i.severity ?? 'minor']}>
                <span class="sev">{severityLabel[i.severity ?? 'minor']}</span>
                <b>{i.title}.</b> {i.text}{i.since && <span class="since">Since version {i.since}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="issues-none">None we know of.</p>
        )}
      </section>

      {game.credits.length > 0 && (
        <section class="wrap section" aria-labelledby="gcredits-title" style="padding-bottom: 0">
          <h2 id="gcredits-title" class="section-title">Built on</h2>
          <Credits credits={game.credits} />
        </section>
      )}

      <section class="wrap section" aria-labelledby="rel-title">
        <h2 id="rel-title" class="section-title">Releases</h2>
        <p class="lede">The installer picks the right one for you. The zips are for installing by hand.</p>
        {releases.length ? (
          <div class="table-scroll">
            <table class="tbl" style="min-width: 980px">
              <caption class="visually-hidden">Every release of {game.name}</caption>
              <thead><tr><th scope="col">Version</th><th scope="col">Maturity</th><th scope="col">Released</th><th scope="col">Tested game builds</th><th scope="col">Core</th><th scope="col">Needs installer</th><th scope="col">SHA-256</th><th scope="col"><span class="visually-hidden">Download</span></th></tr></thead>
              <tbody>
                {releases.map((r) => (
                  <tr>
                    <td class="v">{r.version}{r.notes && <span class="notes">{r.notes}</span>}</td>
                    <td class="nw"><span class:list={['badge', r.maturity]}>{maturityLabel[r.maturity]}</span></td>
                    <td class="nw">{fmtDate(r.date)}</td>
                    <td class="nw mono">{r.testedBuildIds?.join(', ') || '—'}</td>
                    <td class="nw mono">{r.coreVersion ?? '—'}</td>
                    <td class="nw">{r.minAppVersion ? `${r.minAppVersion} or newer` : 'Any'}</td>
                    <td><code>{r.sha256}</code></td>
                    <td class="dl"><a href={r.url}>Zip · {fmtSize(r.size)}<span class="visually-hidden">, version {r.version}</span></a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="small" style="margin-top: 16px">No releases yet.</p>
        )}
      </section>
    </main>
  </Base>
)}
