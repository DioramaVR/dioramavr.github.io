---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Smoke from '../components/Smoke.astro';
import { gamesBySet, installer, pickMedia, mediaUrl, fmtSize, setLabel, statusLabel, type Game } from '../data/load';
import { PATREON, PITCH } from '../site';

const { latest, latestVersion } = installer();
const { grouped, alone } = gamesBySet();
const sections = [
  ...grouped.map(({ set, games }) => ({ key: set.id, label: setLabel(set), status: set.status, games })),
  ...alone.map((g) => ({ key: g.id, label: g.name, status: g.status, games: [g] })),
];
const card = (g: Game) => {
  const { hero } = pickMedia(g.info);
  return { ...g, img: hero && { src: mediaUrl(g.id, hero.file), alt: hero.alt } };
};
---
<Base title="DioramaVR: your games as VR dioramas" description={`${PITCH}. Free VR mods for Windows PC and SteamVR headsets.`} current="home">
  <div slot="top" class="smoke-host">
    <Smoke calm="centre" />
    <Header current="home" />
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-inner">
        <h1 id="hero-title" class="bigword" aria-label="DioramaVR">DıoramaVR</h1>
        <p class="pitch">{PITCH}</p>
        <a class="btn btn-primary btn-big" href={latest?.url ?? '/download/'}>
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
          Download the installer
        </a>
        <p class="small meta">Version {latestVersion} · Windows{latest && ` · ${fmtSize(latest.size)}`} · <a href="/download/">other versions</a></p>
        <p class="small phone-note">On your phone? This runs on your PC: bookmark it for later.</p>
        <p class="small" style="margin-top: 18px">by <span class="scrire">scrıre</span></p>
      </div>
    </section>
  </div>

  <main id="content">
    <section id="games" class="wrap section" aria-labelledby="games-title" style="padding-top: 40px">
      <h2 id="games-title" class="section-title">Games</h2>
      <p class="lede" style="margin-bottom: 44px">A curated collection of mods, each one built for the diorama style. New games arrive in waves.</p>

      {sections.map((s) => {
        const games = s.games.map(card);
        const out = games.filter((g) => g.status !== 'coming');
        const coming = games.filter((g) => g.status === 'coming');
        return (
          <>
            <div class="set-head">
              <h3>{s.label}</h3>
              <span class:list={['badge', s.status]}>{statusLabel[s.status]}</span>
              {s.status === 'coming' && <a class="more" href={PATREON}>Get testing access on Patreon →</a>}
            </div>
            {out.length > 0 && (
              <div class="cards">
                {out.map((g) => (
                  <a class="gamecard" href={`/${g.id}/`}>
                    {g.img && <img src={g.img.src} alt={g.img.alt} loading="lazy" width="960" height="600">}
                    <div class="body">
                      <span class="title">{g.name}</span>
                      {g.tagline && <span class="tag">{g.tagline}</span>}
                      <span class="small">
                        {g.latestStable ? `Stable ${g.latestStable.version}` : g.latestBeta ? `Open beta ${g.latestBeta.version}` : statusLabel[g.status]}
                        {' · '}for {g.game} on Steam
                      </span>
                      <span class="go">See the mod →</span>
                    </div>
                  </a>
                ))}
              </div>
            )}
            {coming.length > 0 && (
              <div class="cards coming-grid" style={out.length ? 'margin-top: 24px' : undefined}>
                {coming.map((g) => (
                  <a class="comingcard" href={`/${g.id}/`}>
                    {g.img && <img src={g.img.src} alt={g.img.alt} loading="lazy" width="640" height="360">}
                    <span class="row">
                      <span>
                        <span class="title" style="display: block">{g.name}</span>
                        <span class="small">{g.closedBeta ? 'In closed beta on Patreon' : 'Coming'}</span>
                      </span>
                      <span class="arrow" aria-hidden="true">→</span>
                    </span>
                  </a>
                ))}
              </div>
            )}
          </>
        );
      })}
    </section>

    <section id="how" class="section-deep" aria-labelledby="how-title">
      <div class="wrap section">
        <h2 id="how-title" class="section-title">How it works</h2>
        <ol class="steps">
          <li>
            <span class="n" aria-hidden="true">1</span>
            <h3>Install</h3>
            <p>Download the DioramaVR installer and run it. It finds the supported games in your Steam library.</p>
            <p class="small">Windows may warn you about a new app first. <a href="/download/#smartscreen">What to do</a></p>
          </li>
          <li>
            <span class="n" aria-hidden="true">2</span>
            <h3>Pick a game</h3>
            <p>Choose one and press Install. The installer downloads the latest version of the mod for you, and keeps it up to date. Uninstalling puts the game back to normal; your saves are never touched.</p>
          </li>
          <li>
            <span class="n" aria-hidden="true">3</span>
            <h3>Put on the headset</h3>
            <p>Load a save as usual and play your game as a diorama in front of you.</p>
          </li>
        </ol>

        <div class="needs">
          <h3>What you need</h3>
          <p class="lead">These are <b>PC VR</b> mods. The game runs on your Windows PC and streams to your headset.</p>
          <div class="flow">
            <div class="item">
              <svg aria-hidden="true" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#edda4b" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8"></path><path d="M12 16v4"></path></svg>
              <div><div class="h">A Windows PC</div><div class="s">with the game installed from Steam</div></div>
            </div>
            <div class="arrow" aria-hidden="true">
              <svg width="56" height="20" viewBox="0 0 56 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 10h50"></path><path d="M44 3l8 7-8 7"></path></svg>
            </div>
            <div class="item">
              <svg aria-hidden="true" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#edda4b" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-4l-2-3h-2l-2 3H5a2 2 0 0 1-2-2z"></path></svg>
              <div><div class="h">A headset that works with SteamVR</div><div class="s">Quest over Link, Air Link or Virtual Desktop; Index, Vive, Pico and others</div></div>
            </div>
          </div>
          <p class="small foot">A headset can’t run these on its own: the PC does the work.</p>
        </div>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="patreon-title">
      <div class="patreon">
        <div>
          <h2 id="patreon-title">Support the project</h2>
          <p>Patrons get testing builds of the next wave every month, so you play the new games before anyone else. Every released mod stays free and open source.</p>
        </div>
        <a class="btn btn-primary btn-l flat" href={PATREON}>Join on Patreon</a>
      </div>
    </section>
  </main>
</Base>
